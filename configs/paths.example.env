# Copy this file to .env.local (repo root) and fill in what your run needs.
# .env.local is gitignored: never commit it.
#
#   cp configs/paths.example.env .env.local
#
# Classification training (train_mfe.py) needs NONE of these: it reads each
# slide's feature directory from the `dir` column of splits/<dataset>/*.csv.

# Survival training (train_survival.py): REQUIRED. Patch-feature H5 root, with
# {cohort} replaced at load time (KIRC, KIRP, LUAD, STAD, UCEC).
TCGA_SURVIVAL_EMBEDDING_ROOT=/path/to/embeddings/TCGA-{cohort}/uni_v2/20x_256/patches

# packed_grid_fidelity.py only. Use the same folders as the `dir` column of the
# dataset CSVs (CAM17 and BRCA are located through that column directly):
#   CAM16: folder that contains normal/, tumor/ and test/, each with h5_files/
#   PANDA: folder that contains h5_files/
CAM16_EMBEDDING_ROOT=/path/to/CAM16/features
PANDA_EMBEDDING_ROOT=/path/to/PANDA/features
